<Window x:Class="SmartX.WPF.LandingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X System Gateway" Height="600" Width="1000"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="⚡ Smart-X Gateway" FontSize="32" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Select an architectural pillar to continue"
                       FontSize="14" Foreground="#A0A0B0"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Three Pillars -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pillar 1: ACTIVE -->
            <Border Grid.Column="0" Background="#2D2D44" CornerRadius="10"
                    Padding="25" Margin="10" Cursor="Hand"
                    MouseLeftButtonUp="Pillar1_Click">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sensor Data Ingestion" FontSize="16"
                               FontWeight="Bold" Foreground="#00D9A5"
                               HorizontalAlignment="Center" Margin="0,15,0,5"/>
                    <TextBlock Text="&amp; Telemetry" FontSize="14"
                               Foreground="#A0A0B0" HorizontalAlignment="Center"/>
                    <Border Background="#00D9A5" CornerRadius="3"
                            Padding="8,3" Margin="0,15,0,0"
                            HorizontalAlignment="Center">
                        <TextBlock Text="ACTIVE" Foreground="#1E1E2E"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Pillar 2: DISABLED -->
            <Border Grid.Column="1" Background="#252538" CornerRadius="10"
                    Padding="25" Margin="10" Opacity="0.5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Real-Time Command" FontSize="16"
                               FontWeight="Bold" Foreground="#A0A0B0"
                               HorizontalAlignment="Center" Margin="0,15,0,5"/>
                    <TextBlock Text="Stream &amp; History" FontSize="14"
                               Foreground="#707080" HorizontalAlignment="Center"/>
                    <Border Background="#707080" CornerRadius="3"
                            Padding="8,3" Margin="0,15,0,0"
                            HorizontalAlignment="Center">
                        <TextBlock Text="PART 2" Foreground="#1E1E2E"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Pillar 3: DISABLED -->
            <Border Grid.Column="2" Background="#252538" CornerRadius="10"
                    Padding="25" Margin="10" Opacity="0.5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🔗" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Network Topology" FontSize="16"
                               FontWeight="Bold" Foreground="#A0A0B0"
                               HorizontalAlignment="Center" Margin="0,15,0,5"/>
                    <TextBlock Text="&amp; Mesh Routing" FontSize="14"
                               Foreground="#707080" HorizontalAlignment="Center"/>
                    <Border Background="#707080" CornerRadius="3"
                            Padding="8,3" Margin="0,15,0,0"
                            HorizontalAlignment="Center">
                        <TextBlock Text="FINAL PoE" Foreground="#1E1E2E"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
