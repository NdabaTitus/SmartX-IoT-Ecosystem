<Window x:Class="SmartX.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X Login" Height="450" Width="400"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="⚡ Smart-X" FontSize="36" FontWeight="Bold" Foreground="#00D9A5" HorizontalAlignment="Center"/>
            <TextBlock Text="Secure Authentication" FontSize="14" Foreground="#A0A0B0" HorizontalAlignment="Center" Margin="0,5,0,30"/>

            <TextBlock Text="Email Address" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox" Padding="10" Background="#3D3D55" Foreground="White" BorderThickness="0" Margin="0,0,0,15"/>

            <TextBlock Text="Password" Foreground="White" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Padding="10" Background="#3D3D55" Foreground="White" BorderThickness="0" Margin="0,0,0,15"/>

            <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

            <Button x:Name="LoginButton" Content="🔒 Login with Firebase" 
                    Padding="15,10" Background="#4A9EFF" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="LoginButton_Click"/>

            <TextBlock x:Name="LoadingText" Text="Authenticating..." Foreground="#FFD93D" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>