<Window x:Class="SmartX.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X IoT Dashboard" Height="900" Width="1400"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#2D2D44"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00D9A5"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4A9EFF"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0B0"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="32" VerticalAlignment="Center"/>
                    <StackPanel Margin="15,0,0,0">
                        <TextBlock Text="Smart-X IoT Dashboard" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Real-Time Command Stream &amp; History" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="ConnectButton" Content="🔌 Connect" Style="{StaticResource ActionButton}" Click="ConnectButton_Click" Margin="15,0,10,0"/>
                    <Button x:Name="LogoutButton" Content="🚪 Logout" Style="{StaticResource ActionButton}" Background="{StaticResource AccentRed}" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- TAB 1: PART 1 (Sensor Data Ingestion) -->
            <TabItem Header="📡 Tab 1: Sensor Data Ingestion (Part 1)">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Part 1: DataGrid -->
                    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="15">
                        <DataGrid x:Name="TelemetryGrid" AutoGenerateColumns="False" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#3D3D55" Foreground="{StaticResource TextPrimary}" BorderThickness="0" HeadersVisibility="Column" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="150"/>
                                <DataGridTextColumn Header="Sensor Type" Binding="{Binding SensorType}" Width="150"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Part 1: Controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="📡 Generate Test Data" Style="{StaticResource ActionButton}" Click="GenerateDataButton_Click" Margin="5"/>
                        <Button Content="🔄 Refresh" Style="{StaticResource ActionButton}" Click="RefreshButton_Click" Margin="5"/>
                        <Button Content="🗑️ Clear All" Style="{StaticResource ActionButton}" Background="{StaticResource AccentRed}" Click="ClearButton_Click" Margin="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: PART 2 (Command Stream) -->
            <TabItem Header="⚙️ Tab 2: Command Stream (Part 2)">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Command Stream & Devices -->
                    <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="15" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Device Registry &amp; Commands" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBox x:Name="SearchBox" Width="200" Padding="5" Text="Search devices..." Margin="0,0,10,0"/>
                                <Button Content="🔍 Search" Style="{StaticResource ActionButton}" Click="SearchButton_Click" Margin="0,0,10,0"/>
                                <Button Content="📁 Upload Devices (.txt)" Style="{StaticResource ActionButton}" Background="#FFD93D" Foreground="Black" Click="UploadDevices_Click"/>
                            </StackPanel>

                            <DataGrid Grid.Row="2" x:Name="DeviceGrid" AutoGenerateColumns="True" Background="Transparent" Foreground="White" RowBackground="Transparent" AlternatingRowBackground="#3D3D55" HeadersVisibility="Column" IsReadOnly="True"/>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <Button Content="💧 Turn On Pump" Style="{StaticResource ActionButton}" Click="CommandPump_Click" Margin="5"/>
                                <Button Content="🔌 Toggle Relay" Style="{StaticResource ActionButton}" Click="CommandRelay_Click" Margin="5"/>
                                <Button Content="↩️ Undo Last Command" Style="{StaticResource ActionButton}" Background="{StaticResource AccentRed}" Click="UndoCommand_Click" Margin="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Automated Insights Panel -->
                    <Border Grid.Column="1" Background="#2D2D44" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="💡 Suggested Actions" FontSize="18" FontWeight="Bold" Foreground="#FFD93D" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" x:Name="InsightsListBox" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: DISABLED -->
            <TabItem Header="🔗 Tab 3: Network Topology (Disabled)" IsEnabled="False">
                <Grid>
                    <TextBlock Text="Coming in Final PoE" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>