<Window x:Class="SmartX.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X IoT Dashboard" 
        Height="900" Width="1400"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="PanelBackground" Color="#2D2D44"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00D9A5"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4A9EFF"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFD93D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0B0"/>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style (Dark theme) -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3D3D55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ComboBox Style (Dark theme with visible items) -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#3D3D55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ComboBoxItem Style (so dropdown items are visible) -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#3D3D55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#4A9EFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#00D9A5"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Row 0: Header                                                -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" 
                CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="32" VerticalAlignment="Center"/>
                    <StackPanel Margin="15,0,0,0">
                        <TextBlock Text="Smart-X IoT Dashboard" 
                                   FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Real-Time Telemetry Monitoring System" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" 
                             Fill="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Disconnected" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Row 1: Statistics Cards                                      -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" 
                    CornerRadius="10" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Readings" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="TotalReadingsText" Text="0" 
                               Foreground="{StaticResource AccentBlue}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" 
                    CornerRadius="10" Padding="20" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="Active Devices" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="ActiveDevicesText" Text="0" 
                               Foreground="{StaticResource AccentGreen}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" 
                    CornerRadius="10" Padding="20" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="Average Value" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="AverageValueText" Text="0.0" 
                               Foreground="{StaticResource AccentYellow}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{StaticResource PanelBackground}" 
                    CornerRadius="10" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Disconnected" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="DisconnectedText" Text="0" 
                               Foreground="{StaticResource AccentRed}" FontSize="32" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- Row 2: Data Grid                                             -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" 
                CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📊 Live Telemetry Feed" 
                           Foreground="{StaticResource TextPrimary}" 
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" x:Name="TelemetryGrid"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#3D3D55"
                          Foreground="{StaticResource TextPrimary}"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#4D4D65"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#3D3D55"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="150"/>
                        <DataGridTextColumn Header="Sensor Type" Binding="{Binding SensorType}" Width="150"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="120"/>
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="8,3" 
                                            Background="{Binding IsConnected, 
                                                Converter={StaticResource BoolToColorConverter}}">
                                        <TextBlock Text="{Binding IsConnected, 
                                                Converter={StaticResource BoolToStatusConverter}}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Row 3: Control Panel                                         -->
        <!-- ============================================================ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" 
                CornerRadius="10" Padding="15" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ConnectButton" Content="🔌 Connect to Gateway" 
                        Style="{StaticResource ActionButton}" 
                        Click="ConnectButton_Click" Margin="5"/>
                <Button x:Name="GenerateDataButton" Content="📡 Generate Test Data" 
                        Style="{StaticResource ActionButton}" 
                        Click="GenerateDataButton_Click" Margin="5"/>
                <Button x:Name="RefreshButton" Content="🔄 Refresh" 
                        Style="{StaticResource ActionButton}" 
                        Click="RefreshButton_Click" Margin="5"/>
                <Button x:Name="ClearButton" Content="🗑️ Clear All" 
                        Style="{StaticResource ActionButton}" 
                        Background="{StaticResource AccentRed}"
                        Click="ClearButton_Click" Margin="5"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Row 4: Sensor Registration + File Upload                     -->
        <!-- ============================================================ -->
        <Border Grid.Row="4" Background="{StaticResource PanelBackground}" 
                CornerRadius="10" Padding="15" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📋 Sensor Registration" 
                           Foreground="{StaticResource TextPrimary}" 
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="MacAddressBox"
                             Style="{StaticResource DarkTextBox}"/>

                    <TextBox Grid.Column="1" x:Name="LocationBox"
                             Style="{StaticResource DarkTextBox}"/>

                    <ComboBox Grid.Column="2" x:Name="CategoryCombo"
                              Style="{StaticResource DarkComboBox}">
                        <ComboBoxItem Content="Environmental" 
                                      Style="{StaticResource DarkComboBoxItem}"/>
                        <ComboBoxItem Content="Power Consumption" 
                                      Style="{StaticResource DarkComboBoxItem}"/>
                        <ComboBoxItem Content="Actuator" 
                                      Style="{StaticResource DarkComboBoxItem}"/>
                    </ComboBox>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="📎 Attach File" Style="{StaticResource ActionButton}"
                                Click="AttachFile_Click" Margin="5"/>
                        <Button Content="✅ Register Sensor" Style="{StaticResource ActionButton}"
                                Background="{StaticResource AccentGreen}"
                                Click="RegisterSensor_Click" Margin="5"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>